<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Journal entries opened from here carry `backdated_resequence` in their
         context: posting them runs the auto-resequence logic even on journals
         that don't have the per-journal toggle switched on. -->
    <record id="action_backdated_journal_entries" model="ir.actions.act_window">
        <field name="name">Backdated Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="domain">[('move_type', '=', 'entry')]</field>
        <field name="context">{'default_move_type': 'entry', 'backdated_resequence': True, 'view_no_maturity': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a backdated journal entry
            </p>
            <p>
                Enter entries in any date order. When you post one with an
                Accounting Date earlier than entries already posted in the
                same numbering period, the numbers of that period are
                reordered chronologically automatically.
            </p>
        </field>
    </record>

    <menuitem id="menu_backdated_journal_entries"
              name="Backdated Journal Entries"
              parent="account.menu_finance_entries"
              action="action_backdated_journal_entries"
              sequence="2"
              groups="account.group_account_invoice"/>
</odoo>
