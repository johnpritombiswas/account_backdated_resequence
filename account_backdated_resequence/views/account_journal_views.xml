<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_backdated_resequence" model="ir.ui.view">
        <field name="name">account.journal.form.backdated.resequence</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="restrict_mode_hash_table" position="after">
                <field name="auto_resequence_backdated"
                       groups="account.group_account_readonly"
                       invisible="type not in ['sale', 'purchase', 'general']"/>
            </field>
        </field>
    </record>
</odoo>
