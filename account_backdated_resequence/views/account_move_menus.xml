<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A plain filtered view onto Journal Entries - no special context
         needed. Every journal gets the auto-correction and reordering
         unconditionally (see account_move.py), so posting from here behaves
         no differently than posting from the standard Journal Entries menu;
         this one just exists as a convenient, purpose-labelled shortcut. -->
    <record id="action_backdated_journal_entries" model="ir.actions.act_window">
        <field name="name">Backdated Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="domain">[('move_type', '=', 'entry')]</field>
        <field name="context">{'default_move_type': 'entry', 'view_no_maturity': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a backdated journal entry
            </p>
            <p>
                Enter entries in any date order. When you post one with an
                Accounting Date earlier than entries already posted in the
                same numbering period, the numbers of that period are
                reordered chronologically automatically - on every journal,
                nothing to configure.
            </p>
        </field>
    </record>

    <menuitem id="menu_backdated_journal_entries"
              name="Backdated Journal Entries"
              parent="account.menu_finance_entries"
              action="action_backdated_journal_entries"
              sequence="2"
              groups="account.group_account_invoice"/>
</odoo>
